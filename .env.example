DATABASE_URL=postgresql://teampulse:local-dev-only@localhost:5432/teampulse?schema=public
# Neon supplies a separate direct URL for migrations. Leave empty for local Postgres.
DATABASE_URL_UNPOOLED=
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Numeric GitHub account ids, not usernames or emails. Used only by the seed.
DEMO_GITHUB_IDS=
# Integration/browser tests MUST use a separate database.
TEST_DATABASE_URL=postgresql://teampulse:local-dev-only@localhost:5432/teampulse_test?schema=public
# Compose only: keep the password consistent with both database URLs.
POSTGRES_PASSWORD=local-dev-only
CONTAINER_DATABASE_URL=postgresql://teampulse:local-dev-only@db:5432/teampulse
